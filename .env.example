# Make a .env in the following format, using your own values as described in the README
# Path to your local Android Studio launcher — used by `make android` to open the native shell.
# Machine-specific (e.g. JetBrains Toolbox installs to a non-default path); only needed if you'll
# run `make android`.
ANDROID_STUDIO_PATH=/path/to/android-studio/bin/studio.sh

# Path to your release-signing keystore.properties (storeFile/storePassword/keyAlias/keyPassword —
# see frontend/apps/app/android/app/build.gradle). Kept outside the repo entirely, not just
# gitignored. Machine-specific; only needed if you'll run `make android-release`.
ANDROID_KEYSTORE_PROPERTIES=/path/to/keystore.properties

# Named AWS SSO profile for local backend testing against real S3 (issue #146's diary-photo upload) -
# `make dev`/`make s3-wipe-diary-photos-dev` export this for you from here. Deliberately not in
# backend/.env: that file is strictly validated by app/config.py's Settings model, which would reject
# a key it doesn't define. Only needed if you're testing the photo-upload feature locally.
AWS_PROFILE=your-profile-name
