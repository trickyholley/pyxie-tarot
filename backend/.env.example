# Make a .env in the following format, using your own values as described in the README
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Optional — without it, password reset links are logged instead of emailed.
RESEND_KEY=
# Optional — set to true to allow `make db-seed`/`make db-restore` against a non-localhost
# DATABASE_URL. Leave unset in normal dev; see app/dev_seed.py.
ALLOW_SEED=
REDIS_URL=redis://localhost:6379/0
# Optional — Gumroad billing, issue #79 redesign. Without these, checkout calls 503. No sandbox exists;
# Gumroad's own guidance for local testing is a real $0.00 test product, unlisted so it doesn't show on
# the public profile - see the dev product below rather than the live $3/$40 listings. Permalink/product
# id come straight from the Gumroad dashboard, no API lookup needed. GUMROAD_WEBHOOK_SECRET isn't
# Gumroad-issued - it's a random token generated locally (`python3 -c "import secrets;
# print(secrets.token_urlsafe(32))"`) and embedded as the last segment of the one webhook URL you
# register in Gumroad's Ping setting (see app/core/gumroad.py for why there's only one URL/route).
GUMROAD_SELLER_SUBDOMAIN=pyxietarot
GUMROAD_ACCESS_TOKEN=
GUMROAD_WEBHOOK_SECRET=
GUMROAD_PRODUCT_PERMALINK_MONTHLY=dev-path-monthly
GUMROAD_PRODUCT_ID_MONTHLY=ndkkub
GUMROAD_PRODUCT_PERMALINK_PERPETUAL=path-complete
GUMROAD_PRODUCT_ID_PERPETUAL=flxdig
