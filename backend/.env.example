# Make a .env in the following format, using your own values as described in the README
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Optional — without it, password reset links are logged instead of emailed.
RESEND_KEY=
# Optional — set to true to allow `make db-seed`/`make db-restore` against a non-localhost
# DATABASE_URL. Leave unset in normal dev; see app/dev_seed.py.
ALLOW_SEED=
REDIS_URL=redis://localhost:6379/0
# Optional — Polar (polar.sh) billing, issue #79. Without these, checkout/portal calls 503. To exercise
# the real subscribe flow in dev, use a Polar *sandbox* org (free, fully isolated from prod) rather than
# live credentials: create one at https://sandbox.polar.sh/start, mint an access token and product ids
# there (a sandbox access token only works against the sandbox API, not api.polar.sh), then set:
POLAR_API_BASE_URL=https://sandbox-api.polar.sh
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID_MONTHLY=
POLAR_PRODUCT_ID_ANNUAL=
