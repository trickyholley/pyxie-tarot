# Make a .env in the following format, using your own values as described in the README
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Optional — without it, password reset links are logged instead of emailed.
RESEND_KEY=
# Optional — set to true to allow `make db-seed`/`make db-restore` against a non-localhost
# DATABASE_URL. Leave unset in normal dev; see app/dev_seed.py.
ALLOW_SEED=
REDIS_URL=redis://localhost:6379/0
