# Make a .env in the following format, using your own values as described in the README
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Optional — without it, password reset links are logged instead of emailed.
RESEND_KEY=
# Optional — set to true to allow `make db-seed`/`make db-restore` against a non-localhost
# DATABASE_URL. Leave unset in normal dev; see app/dev_seed.py.
ALLOW_SEED=
REDIS_URL=redis://localhost:6379/0
# Optional — Gumroad billing, issue #79 redesign. Without these, checkout calls 503. No sandbox exists,
# and the Ping URL is a single account-wide setting (see app/core/gumroad.py), so test against a second,
# throwaway Gumroad seller account rather than risk ever repointing the real one's webhook. Permalink
# comes straight from the dashboard; short_product_id only shows up in an actual webhook payload (not the
# dashboard, and not the same as the permalink or the long product_id) - point that account's Ping URL at
# something like webhook.site and make one real $0 test purchase per product to read it off.
# GUMROAD_WEBHOOK_SECRET isn't Gumroad-issued either - it's a random token generated locally (`python3 -c
# "import secrets; print(secrets.token_urlsafe(32))"`) and embedded as the last segment of the webhook
# URL you then register in Gumroad's Ping setting.
GUMROAD_SELLER_SUBDOMAIN=pyxietarot
GUMROAD_WEBHOOK_SECRET=
GUMROAD_PRODUCT_PERMALINK_MONTHLY=dev-path-monthly
GUMROAD_PRODUCT_ID_MONTHLY=ndkkub
GUMROAD_PRODUCT_PERMALINK_PERPETUAL=path-complete
GUMROAD_PRODUCT_ID_PERPETUAL=flxdig
