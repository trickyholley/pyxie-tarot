# Make a .env in the following format, using your own values as described in the README

## Store keys and variables

# Gumroad on web - matches backend/.env.example's GUMROAD_* vars.
VITE_GUMROAD_SELLER_SUBDOMAIN=pyxiedev
VITE_GUMROAD_PRODUCT_PERMALINK_MONTHLY=one-step
VITE_GUMROAD_PRODUCT_PERMALINK_PERPETUAL=the-whole-journey

# RevenueCat on iOS
VITE_REVENUECAT_APPLE_API_KEY=appl_XXX

# RevenueCat on Android (Play Store installs only)
VITE_REVENUECAT_GOOGLE_API_KEY=goog_XXX
