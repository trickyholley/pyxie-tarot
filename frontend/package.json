{
  "name": "pyxie-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "format": "oxfmt '**/*.{js,jsx,ts,tsx}'",
    "lint": "oxlint .",
    "preview": "pnpm -r --parallel run preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "i18next": "^26.4.2",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "terser": "^5.51.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.27.0"
}
