# Copy to infra/.env on the droplet (gitignored), fill in real values.
# This file is normally generated by fetch-secrets.sh, not hand-written -
# see that script for where each value comes from.
# No DB password - the backend authenticates to RDS with a short-lived IAM
# token instead (app/database.py), so there's nothing here to leak.
DATABASE_USE_IAM_AUTH=true
DATABASE_HOST=db-host
DATABASE_PORT=5432
DATABASE_USER=pyxie
DATABASE_NAME=pyxie_tarot
AWS_REGION=us-east-1
# Generate a fresh secret for prod — do not reuse the local dev SECRET_KEY.
SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Optional — without it, password reset links are logged instead of emailed.
RESEND_KEY=
# Without these, emailed links (password reset, email confirmation) fall back
# to the http://localhost defaults meant for local dev.
FRONTEND_APP_URL=https://pyxietarot.live
FRONTEND_ADMIN_URL=https://admin.pyxietarot.live
