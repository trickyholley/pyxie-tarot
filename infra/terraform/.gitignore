# Local .terraform directories (provider plugin cache, regenerated by `terraform init`)
**/.terraform/*

# State files - never committed; remote state lives in S3 (see bootstrap/)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files may contain secrets - never commit real values
*.tfvars
*.tfvars.json

# Override files are for local-only resource overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files may contain sensitive values
*tfplan*

# CLI config files (may contain credentials-adjacent settings)
.terraformrc
terraform.rc
